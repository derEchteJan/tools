#!/bin/bash
# Bash config for build commands
# usage: '. bashrc' or 'source bashrc'

source ./site.conf

echo ''
echo 'Build commands:'

# compile generator
alias build='
if [ ! -d ./build ]; then
    mkdir ./build
fi
echo compiling generator sources &&\
(
    cd ./build &&\
    g++ -c ../source/*.cpp &&\
    g++ *.o --static -o generator
)
echo "compiled binary:" &&\
ls -algh --color ./build/generator'
echo ' - build:             compiles generator binary'

# test generator binary
alias  test-gen='document_root="$(pwd)/html" ./build/generator file=html/pages/format.md'
alias test-genr='document_root="$(pwd)/html" ./build/generator dir=pages'
echo ' - test-gen:          runs generator locally on a single file (format.md)'
echo ' - test-genr:         runs generator locally recursive on ./html/pages'

# get id of running container (add '-a' to include stopped)
f_container_running() {
  if [ "$(container-id)" != "" ]
  then
    return 0
  else
    echo "container $CONTAINER_NAME isnt running"
    return 1
  fi
}
alias container-id='sudo docker ps -q --filter name=$CONTAINER_NAME'
alias container-running='f_container_running'
echo ' - container-id:      prints running container id, used by other commands. (add "-a" to include stopped)'
echo ' - container-running: returns true if container is running (usage e.g.: container-running && do stuff)'

# build container image
alias container-build='echo building container image "$IMAGE_NAME" && sudo docker build -t $IMAGE_NAME .'
echo ' - container-build:   builds container image'

# create and run container
alias run='echo running container && sudo docker run --detach -p $RO_PORT:80 -p $RW_PORT:81 --name $CONTAINER_NAME $IMAGE_NAME && 
sudo docker cp ./site.conf $(container-id):$DOC_ROOT &&
generate-all'
echo ' - run:               creates container and starts it'

# stop and remove container
alias remove='echo removing container image "$IMAGE_NAME" && sudo docker rm -f $(container-id -a)'
echo ' - remove:            removes container'

# start container
alias start='
if [[ "$(container-id -a)" == "" ]];
then
    echo "creating and starting container $CONTAINER_NAME"
    run
elif [[ "$(container-id)" == "" ]];
then
    echo "starting container $CONTAINER_NAME"
    sudo docker start $(container-id -a)
else
    echo "already running -> $(container-id)"
fi'
echo ' - start:             starts container, builds image if necessary'

# stop container
alias stop='sudo docker kill $(container-id)'
echo ' - stop:              stops container'

# list process status
alias status='sudo docker ps -a'
echo ' - status:            show process status of containers'

# start shell inside running container
alias shell='sudo docker exec -it $(container-id) bash'
echo ' - shell:             start bash shell inside running container'

# copy current webfiles into running container
alias webcopy='sudo docker cp ./html/. $(container-id):$DOC_ROOT &&\
sudo docker cp ./site.conf $(container-id):$DOC_ROOT &&\
sudo docker exec -it $(container-id) chown -R www-data:www-data $DOC_ROOT'
echo ' - webcopy:           copy current webfiles into running container'

# copy generator binary into running container
alias bincopy='sudo docker cp ./build/generator $(container-id):/usr/bin'
echo ' - bincopy:           copy generator binary into running container'

alias generate-all='echo "generating pages" && curl localhost:$RW_PORT/.actions/generate.php? && echo ""'
echo ' - generate-all:      calls api to generate run generator on all pages inside container'